generator client {
    provider = "prisma-client-js"
}

datasource db {
    url      = env("DATABASE_URL")
    provider = "postgresql"
}

model User {
    id Int @id @default(autoincrement())

    fullName String
    email    String @unique
    password String

    createdAt DateTime @default(now())
    updateAt  DateTime @updatedAt
}

model Category {
    id        Int       @id @default(autoincrement())
    name      String    @unique
    products  Product[]
    createdAt DateTime  @default(now())
    updateAt  DateTime  @updatedAt
}

model Product {
    id Int @id @default(autoincrement())

    name     String
    imageUrl String

    createdAt DateTime @default(now())
    updateAt  DateTime @updatedAt

    category   Category? @relation(fields: [categoryId], references: [id])
    categoryId Int?

    ingredients Ingredient[]
}

model Ingredient {
    id       Int    @id @default(autoincrement())
    name     String
    price    Int
    imageUrl String

    products Product[]

    createdAt DateTime @default(now())
    updateAt  DateTime @updatedAt
}
